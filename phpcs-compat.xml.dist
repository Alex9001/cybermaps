<?xml version="1.0"?>
<ruleset name="Cybermaps PHP compatibility">
	<description>PHP 8.2+ compatibility gate for the shipped Cybermaps runtime.</description>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg value="ps"/>

	<file>cybermaps.php</file>
	<file>uninstall.php</file>
	<file>src</file>

	<exclude-pattern>*/clean/*</exclude-pattern>
	<exclude-pattern>*/freemius/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>

	<config name="testVersion" value="8.2-"/>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
