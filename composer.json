{
    "name": "cyberbrand/cybermaps",
    "description": "A focused WordPress sitemap engine with llms.txt, literal Markdown page alternates, and AI-readable discovery publications.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpcompatibility/phpcompatibility-wp": "^2.1.8",
        "phpunit/phpunit": "^10.5",
        "wp-coding-standards/wpcs": "^3.4.1"
    },
    "autoload": {
        "psr-4": {
            "Cybermaps\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cybermaps\\Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "/tests/bootstrap.php",
            "/tests/mocks/",
            "/tests/fixtures/",
            "/tests/integration/"
        ]
    },
    "scripts": {
        "test": "python3 -B bin/workspace.py run php vendor/bin/phpunit",
        "lint:phpcompat": "phpcs --standard=phpcs-compat.xml.dist",
        "lint:phpcs": "phpcs --standard=phpcs.xml.dist",
        "lint:complexity": "phpcs --standard=phpcs.xml.dist --sniffs=Generic.Metrics.CyclomaticComplexity",
        "lint:phpcbf": "phpcbf --standard=phpcs.xml.dist",
        "i18n:generate": "bash bin/generate-pot.sh",
        "i18n:check": "bash bin/generate-pot.sh --check",
        "manifest:check": "php bin/check-manifest.php",
        "ai-config:check": "php bin/check-ai-configuration.php",
        "runtime:check": [
            "php bin/check-runtime-baseline.php",
            "python3 tests/tooling/test_runtime_baseline.py"
        ],
        "test:wporg-source": "python3 tests/tooling/test_wporg_source.py",
        "wporg:check": [
            "php bin/check-wporg-source.php",
            "@test:wporg-source"
        ],
        "release:check": [
            "@runtime:check",
            "@lint:phpcompat",
            "@lint:phpcs",
            "@wporg:check",
            "@mcp:check",
            "python3 -B bin/check-distribution.py",
            "@i18n:check",
            "@manifest:check",
            "@ai-config:check",
            "@test:website-contract",
            "@tooling:lint",
            "@test:release-github",
            "@test:release-workflow",
            "@test:release-gates",
            "python3 -B tests/tooling/test_plugin_check_result.py"
        ],
        "release:build": [
            "Composer\\Config::disableProcessTimeout",
            "bash clean.sh"
        ],
        "release:validate": [
            "Composer\\Config::disableProcessTimeout",
            "python3 -B bin/release_gate.py validate"
        ],
        "tooling:lint": "bash -n clean.sh && bash -n bin/validate-release.sh && bash -n bin/validate-plugin-check.sh && bash -n bin/generate-pot.sh && bash -n bin/release-github.sh && php -l bin/check-manifest.php && php -l bin/check-ai-configuration.php && php -l bin/check-runtime-baseline.php && php -l bin/check-wporg-source.php && bash -n bin/workspace.sh && python3 -B bin/lint-tooling.py && bash -n bin/package-candidate.sh && php -l bin/security-inventory.php",
        "release:github": [
            "Composer\\Config::disableProcessTimeout",
            "bash bin/release-github.sh"
        ],
        "test:release-github": "python3 tests/tooling/test_release_github.py",
        "test:website-contract": "python3 tests/tooling/test_website_contract.py",
        "release": [
            "Composer\\Config::disableProcessTimeout",
            "python3 -B bin/release-workflow.py release"
        ],
        "dev:install": [
            "Composer\\Config::disableProcessTimeout",
            "python3 -B bin/release-workflow.py dev-install"
        ],
        "release:resume": [
            "Composer\\Config::disableProcessTimeout",
            "python3 -B bin/release-workflow.py resume"
        ],
        "test:release-workflow": "python3 -B tests/tooling/test_release_workflow.py",
        "release:ready": [
            "Composer\\Config::disableProcessTimeout",
            "python3 -B bin/release_gate.py ready"
        ],
        "release:status": "python3 -B bin/release_gate.py status",
        "test:release-gates": "python3 -B -m unittest discover -s tests/tooling -p test_gate_*.py",
        "validation:setup": "python3 -B bin/setup-validation.py",
        "mcp:check": [
            "php bin/check-mcp-contract.php",
            "python3 -B tests/tooling/test_mcp_contract.py"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    }
}
